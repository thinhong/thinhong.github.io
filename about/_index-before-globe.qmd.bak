```{r}
#| echo: false
#| results: asis
# Inject the country geometry and the travel data into the page as JSON so the
# map (plain D3) can read them. Both stay in editable files: world.geojson and
# travel.json. To add a trip, add one object to travel.json; nothing else changes.
geo <- paste(readLines("world.geojson", encoding = "UTF-8"), collapse = "")
trv <- paste(readLines("travel.json", encoding = "UTF-8"), collapse = "")
cat('\n<script type="application/json" id="geo-data">', geo, '</script>\n', sep = "")
cat('<script type="application/json" id="travel-data">', trv, '</script>\n\n', sep = "")
```

```{=html}
<style>
/* ===== About page: the travel map (.ab-*). Everything else uses the shared classes in _theme/theme.scss ===== */
.ab-mapwrap{ display:flex; flex-direction:column; gap:6px; }
.ab-top{ display:grid; grid-template-columns:minmax(0,1fr); align-items:center; gap:0 20px; }
@media (min-width:700px){ .ab-top{ grid-template-columns:minmax(0,1fr) auto; } }
.ab-regions{ gap:0 8px; }  /* one line that scrolls sideways on phones: the .scroll-x class in the markup */
.ab-region{ min-height:32px; margin:6px 0; padding:0 13px; border:0; border-radius:999px; background:var(--ne-bg); color:var(--ne-fg); font:inherit; font-size:14px; font-weight:500; white-space:nowrap; cursor:pointer; }
.ab-region{ position:relative; }
.ab-region::after{ content:""; position:absolute; inset:-6px 0; }  /* 44px touch target */
.ab-region:active{ opacity:.65; }
.ab-region.active{ background:var(--ink); color:var(--bg); }
.ab-legend{ display:flex; flex-wrap:wrap; align-items:center; gap:4px 18px; min-height:44px; font-size:13.5px; color:var(--muted); }
.ab-legend span{ display:inline-flex; align-items:center; gap:7px; }
.ab-legend i{ width:12px; height:12px; }
.ab-legend .v{ background:var(--bl); } .ab-legend .h{ background:var(--te-fg); }

.ab-map{ position:relative; overflow:hidden; border:1px solid var(--hair); background:var(--bg); }
.ab-map svg{ display:block; width:100%; height:auto; touch-action:pan-y; }
@media (hover:hover){ .ab-map svg{ cursor:grab; } .ab-map svg:active{ cursor:grabbing; } }
.ab-map.is-full{ position:fixed; inset:0; z-index:1200; border:0; background:var(--bg); display:grid; place-items:center; }
.ab-map.is-full svg{ touch-action:none; max-height:100dvh; }
.ab-sphere{ fill:transparent; }
.ab-grat{ fill:none; stroke:var(--hair); stroke-width:.4; opacity:.6; }
.ab-country{ fill:var(--land); stroke:var(--bg); stroke-width:.5; vector-effect:non-scaling-stroke; }
.ab-country.visited{ fill:var(--bl); cursor:pointer; transition:fill .2s var(--ease); }
@media (hover:hover){ .ab-country.visited:hover{ fill:var(--in); } }
.ab-country.home{ fill:var(--te-fg); cursor:pointer; transition:fill .2s var(--ease); }
@media (hover:hover){ .ab-country.home:hover{ fill:var(--te); } }
.ab-dot{ fill:var(--bg); stroke:var(--bl-fg); stroke-width:2; vector-effect:non-scaling-stroke; pointer-events:none; }
.ab-dot.home{ fill:var(--bg); stroke:var(--te-fg); }
.ab-hit{ fill:transparent; pointer-events:all; cursor:pointer; }
.ab-halo{ fill:var(--te); opacity:.4; pointer-events:none; transform-box:fill-box; transform-origin:center; animation:ab-halo 2.6s var(--ease) infinite; }
@keyframes ab-halo{ 0%{ transform:scale(.7); opacity:.45 } 70%{ opacity:0 } 100%{ transform:scale(2.3); opacity:0 } }
.ab-hint{ position:absolute; left:14px; top:12px; font-size:12.5px; color:var(--muted); pointer-events:none; }
.ab-mapctrl{ position:absolute; top:12px; right:12px; display:flex; flex-direction:column; gap:6px; }
.ab-mapctrl button{ width:38px; height:38px; border:1px solid var(--hair); background:var(--bg); color:var(--ink); font-size:1.15rem; line-height:1; cursor:pointer; display:grid; place-items:center; }
.ab-mapctrl button svg{ width:17px; height:17px; }
.ab-info{ position:absolute; left:14px; bottom:14px; max-width:60%; background:var(--bg); border:1px solid var(--hair); padding:12px 15px; opacity:0; transform:translateY(8px); transition:opacity .25s var(--ease), transform .25s var(--ease); pointer-events:none; }
.ab-info.show{ opacity:1; transform:none; }
.ab-info h4{ margin:0 0 6px; font-size:16px; font-weight:600; color:var(--ink); }
.ab-info .r{ font-size:13.5px; color:var(--muted); padding:2px 0; }
.ab-info .r b{ color:var(--bl-fg); font-weight:600; }
@media (max-width:680px){
  /* small screens: the buttons sit in a row under the map, so they do not cover it */
  .ab-mapctrl{ position:static; flex-direction:row; justify-content:flex-end; gap:8px; padding:8px; border-top:1px solid var(--hair); }
  .ab-mapctrl button{ width:44px; height:44px; font-size:1rem; }
  .ab-info{ left:8px; right:8px; bottom:68px; max-width:none; }
  .ab-hint{ display:none; }
  .ab-map.is-full .ab-mapctrl{ position:absolute; top:12px; right:12px; flex-direction:column; padding:0; border:0; }
  .ab-map.is-full .ab-info{ bottom:8px; }
}
@media (prefers-reduced-motion:reduce){ .ab-halo{ animation:none; opacity:0; } }
</style>

